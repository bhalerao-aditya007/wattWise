# ==============================================================================
# WATTWISE BACKEND SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
PORT=4000
NODE_ENV=development
JWT_SECRET=wattwise_tpds3_secret_key_production_2026

# Database Configuration (MongoDB Atlas Free Tier M0)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wattwise?retryWrites=true&w=majority
MONGODB_URI=

# IoT MQTT Broker Configuration
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=wattwise/household

# Optional AI LLM Copilot Keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=
