# ==============================================================================
# WATTWISE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your keys and passwords.
# NOTE: If MySQL credentials are left blank, WattWise automatically activates its
# zero-setup, high-performance in-memory repository with full seed data.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=wattwise_tpds3_secret_key_production_2026

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL 8.0)
# ------------------------------------------------------------------------------
# Set these to connect your local or cloud MySQL instance (e.g. Aiven, PlanetScale, AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=wattwise

# ------------------------------------------------------------------------------
# 3. Hardware & IoT MQTT Broker Configuration
# ------------------------------------------------------------------------------
# Mosquitto / HiveMQ / EMQX broker for ESP32 energy sensors & smart plug telemetry
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=wattwise/household

# ------------------------------------------------------------------------------
# 4. Optional AI LLM Keys (Local deterministic multilingual engine is default)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 5. Optional Frontend API Target (Used when deploying web independently to Vercel)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
